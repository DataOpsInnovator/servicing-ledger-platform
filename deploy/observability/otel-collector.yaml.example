# Collector configuration for an independently installed, private collector.
# Apply only after configuring a real authenticated HTTPS backend and secret injection.
receivers:
  otlp:
    protocols:
      http:
        endpoint: 0.0.0.0:4318
processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 128
  batch: {}
exporters:
  otlphttp:
    endpoint: ${env:TRACE_BACKEND_URL}
    headers:
      Authorization: ${env:TRACE_BACKEND_AUTHORIZATION}
service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, batch]
      exporters: [otlphttp]
